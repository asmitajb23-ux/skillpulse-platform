# Supabase (optional — the app runs in demo mode with realistic mock data when these are not set)
#
# SECURITY:
# - Only NEXT_PUBLIC_* values are exposed to the browser. Use the publishable "anon" key here.
# - NEVER put the secret `service_role` key (or any private key) in this file or in client code.
#   Service-role operations must run server-side (Route Handlers / server actions) and read the
#   secret from a non-public env var, e.g. SUPABASE_SERVICE_ROLE_KEY.
# - Database access is guarded by Row Level Security (see supabase/schema.sql), so the anon key
#   is safe to ship to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Do NOT prefix with NEXT_PUBLIC_. Leave blank in demo mode.
# SUPABASE_SERVICE_ROLE_KEY=
